generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  KITCHEN_STAFF
  VALET_STAFF
  ADMIN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderSource {
  DINE_IN
  SWIGGY
  ZOMATO
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ValetStatus {
  PARKED
  REQUESTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum ValetPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  role         UserRole  @default(CUSTOMER)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Table {
  id             String         @id @default(cuid())
  number         String         @unique
  name           String?
  capacity       Int            @default(4)
  qrCode         String?        @unique
  status         TableStatus    @default(AVAILABLE)
  orders         Order[]
  valetRequests  ValetRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  displayOrder Int        @default(0)
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id              String      @id @default(cuid())
  name            String
  description     String?
  price           Float
  imageUrl        String?
  isVeg           Boolean     @default(true)
  isAvailable     Boolean     @default(true)
  prepTimeMinutes Int         @default(15)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  source        OrderSource   @default(DINE_IN)
  status        OrderStatus   @default(PENDING)
  tableId       String?
  table         Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  totalAmount   Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  customerName  String?
  customerPhone String?
  notes         String?
  items         OrderItem[]
  valetRequests ValetRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity           Int       @default(1)
  unitPrice          Float
  customInstructions String?
  isPrepared         Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

model ValetRequest {
  id            String        @id @default(cuid())
  ticketNumber  String        @unique
  vehicleModel  String
  vehicleNumber String
  parkingSpot   String?
  guestName     String?
  tableId       String?
  table         Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status        ValetStatus   @default(PARKED)
  priority      ValetPriority @default(LOW)
  estimatedMins Int           @default(4)
  requestedAt   DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Ingredient {
  id           String       @id @default(cuid())
  name         String       @unique
  unit         String       @default("kg")
  currentStock Float        @default(0)
  maxCapacity  Float        @default(100)
  reorderLevel Float        @default(20)
  costPerUnit  Float        @default(0)
  batches      StockBatch[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model StockBatch {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  batchNumber  String
  quantity     Float
  supplier     String?
  receivedAt   DateTime   @default(now())
  expiresAt    DateTime
  notes        String?
  createdAt    DateTime   @default(now())
}

model FootfallRecord {
  id                String   @id @default(cuid())
  date              DateTime @unique
  dayOfWeek         String
  actualFootfall    Int
  predictedFootfall Int
  revenue           Float
  weather           String?
  notes             String?
  createdAt         DateTime @default(now())
}
